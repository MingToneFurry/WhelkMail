// Shared Wrangler configuration for the two Cloudflare targets.
//
//   Workers (default):  npm run deploy
//   Pages (existing):   npm run deploy:pages  (functions/ keeps native routing)
//
// The `main`, `assets` and `triggers` keys are used by Workers. Pages uses the
// `functions/` directory and the bindings below. This file is the standard
// `wrangler.jsonc` that the "Deploy to Cloudflare" button expects in the root.
//
// The D1 binding intentionally has NO `database_id`. The Deploy to Cloudflare
// flow provisions the database named below and writes its ID into your new
// repository. `wrangler deploy` also auto-provisions it for CLI deployments.
// If you prefer an existing database, add its `database_id` locally and keep
// that change out of commits when you publish a fork.
//
// The Worker name comes from `name` here, or from the Deploy to Cloudflare
// project/`WRANGLER_CI_OVERRIDE_NAME`. CLI users can also run:
//   WORKER_NAME=my-worker npm run deploy
//
// Secrets are NOT stored here. The Deploy to Cloudflare flow reads
// `.dev.vars.example` and asks for them; CLI users set them with:
//   npx wrangler secret put APP_PASSWORD
//   npx wrangler secret put TOKEN_ENC_KEY
//   npx wrangler secret put CRON_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whelkmail",
  "main": "server/entries/workers.ts",
  "compatibility_date": "2026-11-01",

  // Workers: static frontend from Vite. /api/* goes to the Worker first; every
  // other path is served from the assets with SPA fallback. Pages ignores these
  // keys and serves `dist` through its own build output directory.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Workers runs the notification/sync pass itself; no separate cron deployment
  // is needed. Pages still uses the `worker/` cron.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    "RELAY_PROVIDER": "smtp2go"
  },

  // No database_id on purpose: the Deploy to Cloudflare flow and `wrangler
  // deploy` provision it and write the ID back. Add an existing ID only for a
  // personal CLI deployment.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-client"
    }
  ]

  // Optional archive on R2. Uncomment after creating the bucket.
  // "r2_buckets": [
  //   { "binding": "BUCKET", "bucket_name": "<your-r2-bucket>" }
  // ]
}
