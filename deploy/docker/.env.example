# Copy to deploy/docker/.env and change every value.
# The container refuses to start with this example value, or with anything
# shorter than 10 characters.
APP_PASSWORD=change-me
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Public URL, used for OAuth callbacks, secure cookies and the rate limiter.
# Required in production: without it the origin is rebuilt from the request
# headers, which a client can write.
PUBLIC_ORIGIN=https://mail.example.com

# Optional internal scheduler (vacation responder, notifications, background sync).
CRON_ENABLED=true
# CRON_SECRET=long-random-value
# 筛选器转发标注和默认休假回复的语言，可选 zh-CN（默认）、en、it。
# MAIL_LOCALE=zh-CN

# Optional S3-compatible archive (MinIO, AWS, Backblaze B2, R2 via S3 API).
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=whelkmail
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=whelkmail
# S3_SECRET_ACCESS_KEY=change-me-please
# S3_FORCE_PATH_STYLE=true

# Optional OAuth / relay / push configuration (same names as Workers secrets).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# RELAY_PROVIDER=smtp2go
# RELAY_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
