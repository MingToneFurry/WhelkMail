# Local environment and secrets.
# Wrangler also reads environment-specific files such as .dev.vars.production,
# so the pattern has to cover the suffixes too.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
.wrangler

# Personal deployment config; start from the .example templates.
# `wrangler.jsonc` is tracked with placeholder values for the shared config.
# A legacy local `wrangler.toml` and the cron worker config stay personal.
wrangler.toml
worker/wrangler.toml

# Local Docker deployment overrides stay personal; the Dockerfile, compose.yml
# and .env.example are part of the distributed software and remain tracked.
deploy/docker/compose.override.yml
deploy/docker/docker-compose.override.yml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.kilo/kilo.jsonc
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
