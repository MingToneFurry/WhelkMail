# Only these two are required by the Deploy to Cloudflare setup.
APP_PASSWORD=
# 32 random bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Everything below is optional. Commented entries are not requested by the
# Deploy to Cloudflare setup; add them later in the dashboard or with
# `wrangler secret put`.
# CRON_SECRET is only needed when an external scheduler calls
# POST /api/cron/notifications (the separate worker/ cron used by Pages
# deployments). The Workers entry runs the same work in-process and does not
# read this secret.
# CRON_SECRET=
# 筛选器转发标注和默认休假回复的语言，可选 zh-CN（默认）、en、it。
# MAIL_LOCALE=zh-CN
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# RELAY_PROVIDER=smtp2go
# RELAY_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# UPDATE_CHECK=
